#!/bin/bash

set -euo pipefail

module_name="${MODULE:?MODULE must name an Overleaf module}"
overleaf_app="${OVERLEAF_APP:?OVERLEAF_APP must name an acceptance config}"
web_root="$(pwd)"
module_root="${web_root}/modules/${module_name}"
acceptance_root="${module_root}/test/acceptance"

load_env_file() {
  local env_file="$1"
  local line
  local name
  local value

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    if [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]]; then
      continue
    fi
    if [[ "${line}" != *=* ]]; then
      echo "Invalid environment entry in ${env_file}" >&2
      return 1
    fi

    name="${line%%=*}"
    value="${line#*=}"
    if [[ ! "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo "Invalid environment name in ${env_file}: ${name}" >&2
      return 1
    fi
    if [[
      ${#value} -ge 2 &&
      (("${value:0:1}" == '"' && "${value: -1}" == '"') ||
        ("${value:0:1}" == "'" && "${value: -1}" == "'"))
    ]]; then
      value="${value:1:${#value}-2}"
    fi
    export "${name}=${value}"
  done <"${env_file}"
}

if [[ ! -d "${acceptance_root}" ]]; then
  echo "Module '${module_name}' does not have acceptance tests"
  exit 0
fi

load_env_file "${web_root}/docker-compose.common.env"
load_env_file "${web_root}/local-test.env"

export OVERLEAF_CONFIG="${acceptance_root}/config/settings.test.js"
export BASE_CONFIG="${web_root}/test/acceptance/config/settings.test.${overleaf_app}.js"

exec "${web_root}/bin/test_acceptance_run_dir" "${acceptance_root}"
